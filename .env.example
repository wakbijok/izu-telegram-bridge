# Copy to .env (chmod 600). Never commit .env.

# --- required ---
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your numeric Telegram user id(s), comma-separated
TELEGRAM_ALLOWED_USER_ID=

# --- Claude Code auth ---
# Subscription auth: run `claude setup-token` and put the token here, or rely on
# the machine's `claude` login. ANTHROPIC_API_KEY is deliberately ignored.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Claude Code session ---
# working directory for Claude Code
BRIDGE_CWD=~
BRIDGE_MODEL=claude-fable-5
BRIDGE_FALLBACK_MODEL=claude-sonnet-4-6
# alert-lane default model (empty = follow BRIDGE_MODEL)
# BRIDGE_ALERT_MODEL=
# low | medium | high | xhigh | max
BRIDGE_EFFORT=medium
# default = approve tools via Telegram buttons; bypassPermissions = no prompts
PERMISSION_MODE=default
# BRIDGE_MEDIA_DIR=~/.tg-media
# BRIDGE_MAX_BUFFER_SIZE=16777216

# --- deployment identity (keep out of the repo) ---
# your persona; else a generic default
# BRIDGE_SYSTEM_PROMPT_FILE=config/persona.local.md
# extra MCP servers (JSON object)
# BRIDGE_MCP_SERVERS_FILE=config/mcp.local.json
# how prompts refer to you
# BRIDGE_USER_NAME=
# where non-Claude-Code slashes live
# BRIDGE_COMPANION_BOT=@your_other_bot

# --- timing ---
# 0 = use BRIDGE_HARD_TIMEOUT
TURN_TIMEOUT=0
# s, measured from your latest message
BRIDGE_HARD_TIMEOUT=3600
# s without any activity -> interrupt
BRIDGE_IDLE_TIMEOUT=1200
PROGRESS_AFTER=60
HEARTBEAT_EVERY=240
TICKER_THROTTLE=2.5
TICKER_TAIL=6
# always | auto | off (Bot API rich messages for tables)
BRIDGE_RICH=always
BRIDGE_FILE_LINES=30

# --- optional alert lane (off unless both are set) ---
# ALERT_PORT=8791
# listen address (default 0.0.0.0). 127.0.0.1 is recommended unless your
# alert sources (Grafana/Keep/GLPI/Talk relay) post from other hosts.
# ALERT_BIND=127.0.0.1
# long random bearer token
# ALERT_TOKEN=
# defaults to the first allowed user
# ALERT_CHAT_ID=
# ALERT_TURN_TIMEOUT=600
# ALERT_INCIDENT_HINTS_FILE=config/alert-incident.local.md
# ALERT_TICKET_HINTS_FILE=config/alert-ticket.local.md
# the agent's own GLPI login (its followups are ignored)
# GLPI_TECH_NAME=
# GLPI_MINE_FILE=~/.cache/glpi/mine.json
# GLPI_SAMPLE_FILE=
